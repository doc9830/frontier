{
  "name": "frontier",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "FRONTIER — procedurally generated space sandbox prototype (PWA)",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "verify": "tsc && npm run smoke && npm run render-check",
    "smoke": "node --experimental-strip-types scripts/smoke.ts",
    "browser-check": "npm run build && node scripts/browser-check.mjs",
    "render-check": "esbuild scripts/render-check.tsx --bundle --platform=node --format=cjs --jsx=automatic --outfile=node_modules/.cache/render-check.cjs --log-level=warning && node node_modules/.cache/render-check.cjs",
    "web:pack": "node scripts/pack-web.mjs",
    "android:apk": "node scripts/android-build.mjs assembleRelease",
    "android:debug": "node scripts/android-build.mjs assembleDebug",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.8.3",
    "vite": "^5.4.11"
  }
}
